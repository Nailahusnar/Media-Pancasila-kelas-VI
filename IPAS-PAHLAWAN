    <!-- html2pdf.js library for high-quality PDF rendering -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <!-- Firebase SDK Imports -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, doc, updateDoc, onSnapshot, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Configuration setup
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'lkpd-pahlawan-app';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "demo-api-key",
            authDomain: "demo-app.firebaseapp.com",
            projectId: "demo-app",
            storageBucket: "demo-app.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:abcdef"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        window.db = db;
        window.appId = appId;

        // Authenticate user
        async function initAuth() {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (err) {
                console.warn("Auth initial error, retrying anonymous auth:", err);
                await signInAnonymously(auth);
            }
        }

        initAuth();

        onAuthStateChanged(auth, (user) => {
            if (user) {
                window.currentUser = user;
                listenToSubmissions();
            }
        });

        // Function to submit LKPD data to Firestore
        window.saveSubmissionToCloud = async function(data) {
            if (!auth.currentUser) {
                await initAuth();
            }
            const publicCollectionPath = collection(db, 'artifacts', appId, 'public', 'data', 'lkpd_submissions');
            await addDoc(publicCollectionPath, {
                ...data,
                submittedAt: serverTimestamp(),
                userId: auth.currentUser ? auth.currentUser.uid : 'anon'
            });
        };

        // Function to update teacher grading in Firestore
        window.updateTeacherGradeInCloud = async function(docId, gradeData) {
            if (!auth.currentUser) await initAuth();
            const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'lkpd_submissions', docId);
            await updateDoc(docRef, {
                teacherScores: gradeData.scores,
                totalScore: gradeData.totalScore,
                teacherNotes: gradeData.notes,
                gradedAt: serverTimestamp()
            });
        };

        // Realtime listener for teacher dashboard
        function listenToSubmissions() {
            if (!auth.currentUser) return;
            const publicCollectionPath = collection(db, 'artifacts', appId, 'public', 'data', 'lkpd_submissions');
            
            onSnapshot(publicCollectionPath, (snapshot) => {
                const submissions = [];
                snapshot.forEach((doc) => {
                    submissions.push({ id: doc.id, ...doc.data() });
                });
                
                // Sort by submittedAt descending in JavaScript
                submissions.sort((a, b) => {
                    const timeA = a.submittedAt?.seconds || 0;
                    const timeB = b.submittedAt?.seconds || 0;
                    return timeB - timeA;
                });

                if (window.renderTeacherDashboard) {
                    window.renderTeacherDashboard(submissions);
                }
            }, (error) => {
                console.error("Error listening to submissions:", error);
            });
        }
    </script>

