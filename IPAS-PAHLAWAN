            // --- SECTION A & B EVALUATION (Identitas - Max 20 Points) ---
            if (data.b_nama && data.b_nama.length > 2) score_a_b += 5;
            if (data.b_asal && data.b_asal.length > 2) {
                score_a_b += 5;
                if (matchedDb && matchedDb.keywords_asal.some(kw => data.b_asal.toLowerCase().includes(kw))) {
                    score_a_b += 2; // Bonus accuracy
                }
            }
            if (data.b_julukan && data.b_julukan.length > 2) score_a_b += 4;
            else feedback.push("Bagian B: Julukan pahlawan bisa dibuat lebih rinci.");

            if (data.b_peran && data.b_peran.length > 8) score_a_b += 4;
            score_a_b = Math.min(20, score_a_b);

            // --- SECTION C EVALUATION (Jejak Perjuangan - Max 35 Points) ---
            if (data.c_5) {
                const len = data.c_5.trim().length;
                if (len >= 30) score_c += 12;
                else if (len >= 15) score_c += 8;
                else if (len > 0) score_c += 4;
            } else {
                feedback.push("Bagian C (No. 5): Penjelasan latar belakang perjuangan belum diisi.");
            }

            if (data.c_6) {
                const len = data.c_6.trim().length;
                if (len >= 30) score_c += 12;
                else if (len >= 15) score_c += 8;
                else if (len > 0) score_c += 4;
            } else {
                feedback.push("Bagian C (No. 6): Tindakan penting pahlawan perlu dijelaskan.");
            }

            if (data.c_7) {
                const len = data.c_7.trim().length;
                if (len >= 25) score_c += 11;
                else if (len >= 12) score_c += 7;
                else if (len > 0) score_c += 4;
            } else {
                feedback.push("Bagian C (No. 7): Jasa pahlawan belum dituliskan secara mendalam.");
            }

            // --- SECTION D EVALUATION (Nilai Kepahlawanan - Max 25 Points) ---
            let subD8 = 0;
            if (data.d_8_1 && data.d_8_1.length > 2) subD8 += 6;
            if (data.d_8_2 && data.d_8_2.length > 2) subD8 += 6;
            score_d += subD8;
            if (subD8 < 12) feedback.push("Bagian D (No. 8): Tuliskan 2 sikap teladan secara lengkap.");

            if (data.d_9) {
                const len = data.d_9.trim().length;
                if (len >= 25) score_d += 13;
                else if (len >= 12) score_d += 8;
                else if (len > 0) score_d += 4;
            } else {
                feedback.push("Bagian D (No. 9): Jelaskan contoh penerapan sikap dalam kehidupan sehari-hari.");
            }

            // --- SECTION E & F EVALUATION (Sumber & Refleksi - Max 20 Points) ---
            if (data.e_sumber && data.e_sumber.length > 3) score_e_f += 8;
            else feedback.push("Bagian E: Sebutkan sumber belajar yang digunakan (Buku/Internet).");

            if (data.f_refleksi) {
                const len = data.f_refleksi.trim().length;
                if (len >= 25) score_e_f += 12;
                else if (len >= 12) score_e_f += 7;
                else if (len > 0) score_e_f += 4;
            } else {
                feedback.push("Bagian F: Tulislah pendapat refleksi mengapa kita harus meneladani pahlawan.");
            }

            const totalScore = score_a_b + score_c + score_d + score_e_f;
            const autoNote = feedback.length === 0 
                ? "Sangat baik! Seluruh informasi terisi dengan lengkap, tepat, dan mendalam." 
                : "Catatan evaluasi: " + feedback.join(" ");

            return {
                scores: {
                    a_b: score_a_b,
                    c: score_c,
                    d: score_d,
                    e_f: score_e_f
                },
                totalScore: totalScore,
                notes: autoNote
            };
        }

