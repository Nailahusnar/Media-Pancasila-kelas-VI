            const btn = document.getElementById('btnKirimGuru');
            const originalContent = btn.innerHTML;
            
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-xl"></i> Mengirimkan...`;

            try {
                // Perform automated thorough analysis
                const evalResult = evaluateStudentSubmission(data);
                
                const submissionPayload = {
                    ...data,
                    teacherScores: evalResult.scores,
                    totalScore: evalResult.totalScore,
                    teacherNotes: evalResult.notes
                };

                if (window.saveSubmissionToCloud) {
                    await window.saveSubmissionToCloud(submissionPayload);
                    showToast(`Jawaban LKPD berhasil dikirimkan ke guru!`, 'success');

                    setTimeout(() => {
                        alert(`Terima kasih, ${data.nama}!\n\nLKPD Anda telah berhasil dikirimkan ke Dashboard Guru.`);
                    }, 300);
                } else {
                    throw new Error("Sistem cloud belum siap.");
                }
            } catch (error) {
                console.error("Gagal mengirim LKPD:", error);
                showToast('Gagal mengirimkan. Periksa koneksi internet Anda.', 'error');
            } finally {
                btn.disabled = false;
